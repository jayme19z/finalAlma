+    background: var(--bg-surface);
+    border: 1px solid var(--border);
+    border-radius: var(--radius);
+    transition: all var(--transition);
+}
+
+.weather-highlight:hover {
+    background: var(--bg-card-hover);
+    transform: translateY(-2px);
+    box-shadow: var(--shadow);
+}
+
+.weather-highlight-label {
+    font-size: 0.78rem;
+    font-weight: 600;
+    color: var(--text-dim);
+}
+
+.weather-highlight-value {
+    font-size: 1.5rem;
+    font-weight: 800;
+    color: var(--text);
+    line-height: 1;
+}
+
+.weather-highlight-value--sm {
+    font-size: 1.2rem;
+}
+
+.weather-highlight-unit {
+    font-size: 0.8rem;
+    font-weight: 600;
+    color: var(--text-dim);
+    margin-left: 0.2rem;
+}
+
+/* ===== Tablet ===== */
+@media (max-width: 768px) {
+    .weather-highlights {
+        grid-template-columns: repeat(2, 1fr);
+    }
+
+    .weather-current-temp {
+        font-size: 2.1rem;
+    }
+
+    .weather-current-icon {
+        font-size: 2.75rem;
+    }
+}
+
+/* ===== Small Mobile ===== */
+@media (max-width: 480px) {
+    .weather-current {
+        padding: 1rem;
+    }
+
+    .weather-current-icon {
+        font-size: 2.4rem;
+    }
+
+    .weather-current-temp {
+        font-size: 1.85rem;
+    }
+
+    .weather-highlight {
+        padding: 0.85rem;
+    }
+
+    .weather-highlight-value {
+        font-size: 1.3rem;
+    }
+}
