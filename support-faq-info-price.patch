@@ -0,0 +1,37 @@
+import { Link } from 'react-router-dom'
+import { useLang } from '../i18n/translations'
+import './SupportFaq.css'
+
+export default function Support() {
+    const { t } = useLang()
+    const s = t.profile.support
+
+    return (
+        <div className="support-page container">
+            <Link to="/profile" className="back-link">{t.common.back}</Link>
+            <h1>{s.title}</h1>
+
+            <p className="support-intro fade-in">{s.intro}</p>
+
+            <div className="support-contact-list">
+                <a href={`mailto:${s.email}`} className="support-contact-card card fade-in">
+                    <span className="support-contact-icon">✉️</span>
+                    <div className="support-contact-body">
+                        <span className="support-contact-label">{s.emailLabel}</span>
+                        <span className="support-contact-value">{s.email}</span>
+                    </div>
+                </a>
+
+                <a href={`tel:${s.phone.replace(/\s/g, '')}`} className="support-contact-card card fade-in">
+                    <span className="support-contact-icon">📞</span>
+                    <div className="support-contact-body">
+                        <span className="support-contact-label">{s.phoneLabel}</span>
+                        <span className="support-contact-value">{s.phone}</span>
+                    </div>
+                </a>
+            </div>
+
+            <p className="support-hours fade-in">{s.hours}</p>
+        </div>
+    )
+}
diff --git a/frontend/src/pages/SupportFaq.css b/frontend/src/pages/SupportFaq.css
new file mode 100644
index 0000000..aaa47fd
--- /dev/null
+++ b/frontend/src/pages/SupportFaq.css
@@ -0,0 +1,156 @@
+.support-page,
+.faq-page {
+    padding: 2rem 1.5rem;
+}
+
+.support-page .back-link,
+.faq-page .back-link {
+    display: inline-flex;
+    align-items: center;
+    margin-bottom: 1.5rem;
+    color: var(--accent-light);
+    font-weight: 600;
+    min-height: 44px;
+}
+
+.support-page h1,
+.faq-page h1 {
+    margin-bottom: 2rem;
+}
+
+/* ===== Support ===== */
+.support-intro {
+    color: var(--text-dim);
+    font-size: 1.05rem;
+    line-height: 1.7;
+    margin-bottom: 2rem;
+    max-width: 640px;
+}
+
+.support-contact-list {
+    display: flex;
+    flex-direction: column;
+    gap: 1.25rem;
+    margin-bottom: 2rem;
+}
+
+.support-contact-card {
+    display: flex;
+    align-items: center;
+    gap: 1.25rem;
+    padding: 1.5rem;
+    text-decoration: none;
+    color: inherit;
+    min-height: 44px;
+}
+
+.support-contact-card:hover {
+    border-color: var(--accent);
+}
+
+.support-contact-icon {
+    font-size: 1.75rem;
+    flex-shrink: 0;
+}
+
+.support-contact-body {
+    display: flex;
+    flex-direction: column;
+    gap: 0.25rem;
+    min-width: 0;
+}
+
+.support-contact-label {
+    font-size: 0.8rem;
+    color: var(--text-dim);
+    text-transform: uppercase;
+    letter-spacing: 0.05em;
+    font-weight: 600;
+}
+
+.support-contact-value {
+    font-size: 1.05rem;
+    color: var(--accent-light);
+    font-weight: 600;
+    word-break: break-word;
+}
+
+.support-hours {
+    color: var(--text-dim);
+    font-size: 0.95rem;
+    line-height: 1.6;
+}
+
+/* ===== FAQ ===== */
+.faq-list {
+    display: flex;
+    flex-direction: column;
+    gap: 1rem;
+}
+
+.faq-item {
+    padding: 0;
+    overflow: hidden;
+}
+
+.faq-question {
+    width: 100%;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 1rem;
+    padding: 1.25rem 1.5rem;
+    background: none;
+    border: none;
+    cursor: pointer;
+    text-align: left;
+    font-size: 1.1rem;
+    font-weight: 600;
+    color: var(--text);
+    min-height: 44px;
+}
+
+.faq-chevron {
+    font-size: 1.5rem;
+    color: var(--accent);
+    flex-shrink: 0;
+    line-height: 1;
+}
+
+.faq-answer {
+    padding: 0 1.5rem 1.25rem;
+    color: var(--text-dim);
+    font-size: 1rem;
+    line-height: 1.7;
+}
+
+/* ===== Tablet ===== */
+@media (max-width: 768px) {
+    .support-page,
+    .faq-page {
+        padding: 1.5rem 1rem;
+    }
+}
+
+/* ===== Small Mobile ===== */
+@media (max-width: 480px) {
+    .support-page,
+    .faq-page {
+        padding: 1rem 0.75rem;
+    }
+
+    .support-contact-card {
+        padding: 1.25rem;
+        gap: 1rem;
+    }
+
+    .faq-question {
+        padding: 1rem 1.25rem;
+        font-size: 1rem;
+    }
+
+    .faq-answer {
+        padding: 0 1.25rem 1rem;
+        font-size: 0.9rem;
+    }
+}
